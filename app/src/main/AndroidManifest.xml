<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Yalnızca "bilgisayara şifre gönder" özelliği için: kullanıcı onayladığında, uçtan uca şifreli tek bir
        ileti kullanıcının kendi aktarıcısına gönderilir (bkz. data/RelayClient.kt). Başka ağ erişimi yoktur;
        analitik, çökme raporlama ya da reklam bileşeni içermez.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Yalnızca QR taramak için; kareler cihazda işlenir, kaydedilmez. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
        Otomatik doldurmada "bu alan adını bildiren uygulama gerçekten bilinen bir tarayıcı mı" denetimi
        için imza sertifikasına bakılır; bunun için paketlerin görünür olması gerekir.
        Liste assets/privileged_apps.json ile aynıdır.
    -->
    <queries>
        <package android:name="ai.perplexity.comet" />
        <package android:name="app.vanadium.browser" />
        <package android:name="com.amazon.cloud9" />
        <package android:name="com.android.browser" />
        <package android:name="com.android.chrome" />
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.brave.browser_nightly" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.canary" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.citrix.Receiver" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="com.duckduckgo.mobile.android.debug" />
        <package android:name="com.fido.fido2client" />
        <package android:name="com.google.android.apps.chrome" />
        <package android:name="com.google.android.gms" />
        <package android:name="com.heytap.browser" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.microsoft.emmx.beta" />
        <package android:name="com.microsoft.emmx.canary" />
        <package android:name="com.microsoft.emmx.dev" />
        <package android:name="com.microsoft.emmx.local" />
        <package android:name="com.microsoft.emmx.rolling" />
        <package android:name="com.naver.whale" />
        <package android:name="com.netskope.browser" />
        <package android:name="com.norton.neo" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.browser.beta" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.opera.mini.native.beta" />
        <package android:name="com.oplus.credential" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.sec.android.app.sbrowser.beta" />
        <package android:name="com.talonsec.intune.talon" />
        <package android:name="com.talonsec.talon" />
        <package android:name="com.talonsec.talon_beta" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.vivaldi.browser.snapshot" />
        <package android:name="com.vivaldi.browser.sopranos" />
        <package android:name="com.wsapp.browser" />
        <package android:name="com.yandex.browser" />
        <package android:name="com.yandex.browser.alpha" />
        <package android:name="com.yandex.browser.beta" />
        <package android:name="com.yandex.browser.broteam" />
        <package android:name="com.yandex.browser.canary" />
        <package android:name="com.yandex.browser.corp" />
        <package android:name="com.zoho.primeum.stable" />
        <package android:name="cz.seznam.sbrowser" />
        <package android:name="io.github.jqssun.helium" />
        <package android:name="io.island.Island" />
        <package android:name="io.island.IslandBeta" />
        <package android:name="io.island.IslandCanary" />
        <package android:name="io.island.IslandDev" />
        <package android:name="io.island.island.beta.intune" />
        <package android:name="io.island.island.canary.intune" />
        <package android:name="io.island.island.dev.intune" />
        <package android:name="io.island.island.intune" />
        <package android:name="net.quetta.browser" />
        <package android:name="net.waterfox.android.release" />
        <package android:name="org.chromium.chrome" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.fenix.debug" />
        <package android:name="org.mozilla.fennec_aurora" />
        <package android:name="org.mozilla.fennec_webauthndebug" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.focus.beta" />
        <package android:name="org.mozilla.focus.nightly" />
        <package android:name="org.mozilla.klar" />
        <package android:name="org.mozilla.reference.browser" />
        <package android:name="org.mozilla.rocket" />
    </queries>

    <application
        android:name=".SifreKasaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SifreKasa">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Tarayıcı eklentisinin QR'ı telefonun kendi QR okuyucusuyla okutulduğunda gönderme ekranını açar.
                Bağlantı tek başına hiçbir şey göndermez: kasa kilidi, alan adı gösterimi, kayıt seçimi ve
                biyometrik onay yine gerekir; ekranda isteğin uygulama dışından geldiği belirtilir.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sifrekasa" android:host="send" />
            </intent-filter>
        </activity>

        <!-- Telefondaki uygulama ve tarayıcılarda şifre doldurma. -->
        <service
            android:name=".autofill.SifreKasaAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Geçiş anahtarı sağlayıcısı (Credential Manager). -->
        <service
            android:name=".passkey.SifreKasaCredentialService"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <activity
            android:name=".passkey.PasskeyActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".security.ClearClipboardReceiver"
            android:exported="false" />
    </application>
</manifest>
