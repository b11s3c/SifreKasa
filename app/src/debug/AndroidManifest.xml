<?xml version="1.0" encoding="utf-8"?>
<!--
    YALNIZCA hata ayıklama derlemesi için ekler; sürüm derlemesine girmez:
     - Bu bilgisayarda çalışan yerel aktarıcıya (http) erişim.
     - `sifrekasa://send?…` bağlantısıyla gönderme ekranını açma: emülatörde QR okutmadan test etmek için.
       Sürüm derlemesinde bu bağlantı YOKTUR; istek yalnızca kamerayla QR okutularak alınır.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config_debug">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sifrekasa" android:host="send" />
            </intent-filter>
        </activity>
    </application>
</manifest>
